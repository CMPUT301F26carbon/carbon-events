# ============================================================
# Events (carbon-events) — root .gitignore
# Keeps generated files, personal machine details and secrets
# out of GitHub. Everything needed to build stays in.
# ============================================================

# ---------- Build output (APKs, KDoc/Dokka HTML, test reports) ----------
# All of these are regenerated by Gradle on any machine.
build/
/app/build/
*.apk
*.aab
*.ap_
*.dex
*.class
/captures/
.externalNativeBuild/
.cxx/
output-metadata.json

# Generated KDoc HTML (Dokka) if someone outputs it outside build/
/docs/kdoc/
/dokka/

# Test / coverage / lint reports
/app/reports/
*.exec
*.ec
lint-results*.xml
lint-results*.html

# ---------- Gradle / Kotlin caches ----------
.gradle/
.kotlin/
# Keep the wrapper so anyone (and the TA) can build with ./gradlew
!gradle/wrapper/gradle-wrapper.jar

# ---------- Your machine (contains your Windows username / SDK path) ----------
local.properties

# ---------- Android Studio / IntelliJ settings (differ per person) ----------
.idea/
*.iml
*.iws
*.ipr
.navigation/

# ---------- Secrets — never commit ----------
# Signing keys
*.jks
*.keystore
keystore.properties
# Service account / admin keys (NOT google-services.json, which we do commit)
*service-account*.json
*-adminsdk-*.json
# Local secret files
secrets.properties
.env
.env.*

# ---------- Logs, dumps, temp ----------
*.log
*.hprof
*.tmp
*.bak
*.swp

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db